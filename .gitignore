# Runtime temp & logs (Zero C: drive redirected dirs)
.temp/
logs/

# Python bytecode & temporary atomic write files
__pycache__/
**/__pycache__/
*.py[cod]
*.tmp

# Intermediate runtime caches & checkpoints
checkpoints/
data/article_cache/
data/market_cache/
data/analyzed_cache.json
data/*.db
data/*.db-wal
data/*.db-shm

# Portable x64 Toolchain, Node/Cargo Build Artifacts (<5GB auto-cleaned) & WebView2 Data
.toolchain/
.build/
node_modules/
dist/
src-tauri/target/
portable-release/
telemetry/
webview_data/

